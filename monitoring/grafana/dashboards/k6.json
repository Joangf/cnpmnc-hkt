{
  "uid": "healthcare-k6",
  "title": "Healthcare Load Test (k6)",
  "tags": ["healthcare", "k6"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Virtual users",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(k6_vus)", "legendFormat": "VUs" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (k6 side)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(k6_http_reqs_total[30s]))", "legendFormat": "all" },
        { "refId": "B", "expr": "sum by (scenario) (rate(k6_http_reqs_total[30s]))", "legendFormat": "{{scenario}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Iterations / s by scenario",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (scenario) (rate(k6_iterations_total[30s]))", "legendFormat": "{{scenario}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP duration p95 / p99 (k6 side)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max by (scenario) (k6_http_req_duration_p95)", "legendFormat": "p95 {{scenario}}" },
        { "refId": "B", "expr": "max by (scenario) (k6_http_req_duration_p99)", "legendFormat": "p99 {{scenario}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed requests & checks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "avg(k6_http_req_failed_rate)", "legendFormat": "http_req_failed" },
        { "refId": "B", "expr": "avg(k6_checks_rate)", "legendFormat": "checks passed" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Contention test: bookings created (expect 1)",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(k6_contention_booking_created_total)" }]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Contention test: conflicts (409)",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(k6_contention_booking_conflict_total)" }]
    }
  ]
}
