{
  "uid": "healthcare-backend",
  "title": "Healthcare Backend",
  "tags": ["healthcare"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "handler",
        "label": "Endpoint",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(http_requests_total, handler)",
        "query": { "query": "label_values(http_requests_total, handler)", "refId": "handler" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total requests (range)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(http_requests_total{handler=~\"$handler\"}[$__range]))", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{handler=~\"$handler\"}[1m]))" }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Avg latency",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "red", "value": 0.5 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_request_duration_seconds_sum{handler=~\"$handler\"}[5m])) / sum(rate(http_request_duration_seconds_count{handler=~\"$handler\"}[5m]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"$handler\"}[5m])))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 latency",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 2 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"$handler\"}[5m])))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests / s by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (handler) (rate(http_requests_total{handler=~\"$handler\"}[1m]))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency avg / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"$handler\"}[5m])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"$handler\"}[5m])))", "legendFormat": "p99" },
        { "refId": "C", "expr": "sum(rate(http_request_duration_seconds_sum{handler=~\"$handler\"}[5m])) / sum(rate(http_request_duration_seconds_count{handler=~\"$handler\"}[5m]))", "legendFormat": "avg" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(http_requests_total{status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_requests_total[1m])), 1e-9)", "legendFormat": "5xx ratio" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bookings by result",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (increase(bookings_total[1m]))", "legendFormat": "{{result}}" },
        { "refId": "B", "expr": "sum by (status) (increase(payments_total[1m]))", "legendFormat": "payment {{status}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ERP call p95 by operation",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(erp_call_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}}" }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Latency by endpoint",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "p95", "desc": true }] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "format": "table", "instant": true },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "format": "table", "instant": true },
        { "refId": "C", "expr": "sum by (handler) (rate(http_requests_total[5m]))", "format": "table", "instant": true },
        { "refId": "D", "expr": "sum by (handler) (rate(http_request_duration_seconds_sum[5m])) / sum by (handler) (rate(http_request_duration_seconds_count[5m]))", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true },
          "indexByName": { "handler": 0, "Value #D": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4 },
          "renameByName": { "Value #A": "p95", "Value #B": "p99", "Value #C": "req/s", "Value #D": "avg", "handler": "Endpoint" }
        } }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (count_over_time({service=\"backend\"} [1m]))", "legendFormat": "{{level}}" }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Backend logs (filter with the Request ID variable)",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{service=\"backend\"} |= \"$request_id\" | json" }
      ]
    }
  ]
}
