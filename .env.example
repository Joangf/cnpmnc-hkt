# Copy to .env and adjust. Every value has a safe dev default in docker-compose.yml.
ENV=dev
WEB_PORT=8080

POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare
POSTGRES_DB=healthcare

JWT_SECRET=change-me-in-any-shared-environment
ERP_WEBHOOK_SECRET=erp-webhook-secret
PAYMENT_WEBHOOK_SECRET=payment-webhook-secret

# Public URL the browser uses (payment return URLs, mock checkout links)
PUBLIC_BASE_URL=http://localhost:8080

# Registration OTP email via Resend. Leave RESEND_API_KEY empty in dev to have the API return
# the code in the response instead. onboarding@resend.dev only delivers to the Resend account
# owner's address; use a sender on a verified domain to email real customers.
RESEND_API_KEY=
EMAIL_FROM=CareBook Hospital Booking <onboarding@resend.dev>

# Seeded accounts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
DEMO_PATIENT_EMAIL=patient@example.com
DEMO_PATIENT_PASSWORD=Patient12345!
LOADTEST_PASSWORD=LoadTest123!

# Booking / payment policy (FRD OQ-03, OQ-09 - confirm with the hospital)
PAYMENT_REQUIRES_CONFIRMATION=true
CANCELLATION_CUTOFF_HOURS=24
REFUND_ON_CANCELLATION=true

# Mock ERP behaviour: sync = confirm immediately, async = confirm later via webhook
MOCK_ERP_MODE=sync
MOCK_ERP_REJECT_RATE=0.0
MOCK_ERP_LATENCY_MS=50

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- QA-Scrum kit (Jira + black-box tests in tests/) ---
JIRA_BASE_URL=https://<site>.atlassian.net
JIRA_EMAIL=ban@example.com
JIRA_API_TOKEN=dan_token_vao_day
JIRA_PROJECT=SCRUM
# Tests in tests/ hit the running stack through nginx (make up)
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:8080
# Leave unset: setting it makes tests/conftest.py TRUNCATE every table in that DB before each test.
# TEST_DATABASE_URL=
# KEEP_TABLES=alembic_version
